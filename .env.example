# Brooklyn Suppers — environment variables
# Copy to .env.local for local development, or set in Vercel dashboard.
# All NEXT_PUBLIC_ vars are exposed to the browser at build time.

# Server-only newsletter integration. Never prefix these with NEXT_PUBLIC_.
# Use a Mailchimp API key for the existing audience (us9).
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=bfc2de2d8a

# Server-only contact email integration. CONTACT_FROM_EMAIL must be a sender
# on a domain verified in Resend. The recipient is fixed in code to Alex.
# Leave false until recipient inbox delivery is verified, then enable and redeploy.
CONTACT_FORM_ENABLED=false
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# ── Dinner Announcement Banner ────────────────────────────────────────────────
# When set, a terracotta banner appears at the top of every page.
# Leave unset (or delete from Vercel) to hide the banner between dinners.
# Redeploy after every change: NEXT_PUBLIC_ values are compiled at build time.
#
# NEXT_PUBLIC_NEXT_DINNER_DATE=June 14
# NEXT_PUBLIC_NEXT_DINNER_SPOTS=3
